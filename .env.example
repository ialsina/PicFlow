# PicFlow Docker Compose — copy to .env and adjust.

# --- Mode A: fully local (default URLs assume `docker compose --profile ml up`) ---
PICFLOW_ML_BASE_URL=http://ml-service:8001
PICFLOW_ML_API_KEY=dev-local-key
PICFLOW_ML_ENABLED=true

# --- Mode B: distributed (platform local, ML on a remote VPS) ---
# Omit the ml-service container (do not use --profile ml). Point backend at your VPS:
# PICFLOW_ML_BASE_URL=https://ml.your-vps.example
# PICFLOW_ML_API_KEY=<shared-secret>
# PICFLOW_ML_TLS_VERIFY=true

# Postgres host port when using compose (optional)
# PICFLOW_POSTGRES_PORT=5432

# Image folder mounted into backend at /data/images (host path)
# PICFLOW_IMAGE_MOUNT=./sample-images
