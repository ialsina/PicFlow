# Copy to backend/.env for local uvicorn (not used by Docker Compose by default).

# When Postgres runs via docker compose on a non-default host port:
# PICFLOW_DATABASE_URL=postgresql+psycopg://picflow:picflow@localhost:5434/picflow

PICFLOW_DATABASE_URL=postgresql+psycopg://picflow:picflow@localhost:5432/picflow
PICFLOW_ALLOWED_ROOTS=/path/to/your/photos
